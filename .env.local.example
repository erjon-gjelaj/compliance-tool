# Copy to .env.local and fill in. Never commit .env.local — it is gitignored.

# Canonical site origin, no trailing slash (used for metadata, sitemap, JSON-LD).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase. All three come from Dashboard > Project Settings > API.
#
# The publishable (anon) key is safe to expose: the leads table is
# insert-only for that role, so it cannot read anything back out.
#
# SUPABASE_SERVICE_ROLE_KEY is the opposite — it bypasses row level security
# entirely and can read and write every table. It is required for the Scope B
# intake, because a submission is written a step at a time and the server has
# to update a row it created earlier; that table is closed to the anon role
# for exactly that reason. It is server-only and must NEVER take a
# NEXT_PUBLIC_ prefix — that would hand every visitor's browser full access
# to the database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret guarding the internal-only endpoints — currently the
# submission hard-delete at DELETE /api/submissions/<id>, and later the
# internal submissions page. Not an auth system on purpose: no accounts, no
# sessions, one secret held by the one person who needs it.
#
# Generate something long and random, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Leave it unset and those endpoints answer 404, so an unconfigured
# deployment doesn't advertise that they exist. Server-only: never
# NEXT_PUBLIC_.
ADMIN_SECRET=

# Signing key for client sign-in tokens (the dashboard at /dashboard).
#
# This one key signs both the 15-minute sign-in link and the 7-day session
# cookie, and nothing about a session is stored in the database — the token
# IS the session. So this value is the entire security of every client's
# documents: anyone holding it can mint a session for any address.
#
# Generate one with:
#   openssl rand -base64 48
#
# At least 32 characters or sign-in refuses to start. There is deliberately
# no development default — a placeholder that reached production once would
# forge everybody's session.
#
# Rotating it signs every client out immediately, everywhere. That is also
# the only way to revoke a session before its 7 days are up, so it is worth
# knowing it works. Server-only: never NEXT_PUBLIC_.
AUTH_JWT_SECRET=

# Free-tier model used only for document revision analysis.
#
# OpenRouter setup:
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=openrouter/free
#
# The key is server-only. Never give any LLM_* variable a NEXT_PUBLIC_ prefix.
# LLM_MAX_TOKENS caps output for providers whose free models reject larger
# limits. A missing key or model disables revisions without affecting the app.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MAX_TOKENS=8192
